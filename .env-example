# Salin menjadi .env lalu ganti semua nilai "ganti-...". Jangan commit file .env ke Git.

# Database
DB_NAME=rpl
DB_USER=rpl_app
DB_PASSWORD=ganti-dengan-password-kuat
DB_ROOT_PASSWORD=ganti-dengan-password-root-kuat

# Admin pertama (dibuat AdminBootstrapRunner bila belum ada admin)
ADMIN_USERNAME=admin@gmail
ADMIN_PASSWORD=ganti-dengan-password-admin

# Versi JDK, samakan dengan java.version di pom.xml
JAVA_VERSION=25

# Port nginx di komputer Anda. Ganti ke 8081 bila port 80 sudah dipakai.
WEB_PORT=80